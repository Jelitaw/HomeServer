#!/bin/bash
set -euo pipefail

RESTIC_DIR="/path/to/restic"
source "$RESTIC_DIR/env"

LOG_FILE="$RESTIC_DIR/backup.log"

export RESTIC_REPOSITORY
export RESTIC_PASSWORD_FILE

BACKUP_PATHS="/path/to/application-data"

echo "=== Restic backup started: $(date) ===" >> "$LOG_FILE"

if restic backup "$BACKUP_PATHS" \
    --verbose \
    --tag daily \
    --exclude-file="$RESTIC_DIR/excludes.txt" \
    >> "$LOG_FILE" 2>&1
then
    STATUS="SUCCESS"
else
    STATUS="FAILED"
fi

echo "=== Pruning old snapshots ===" >> "$LOG_FILE"

restic forget \
    --keep-daily 7 \
    --keep-weekly 4 \
    --keep-monthly 6 \
    --prune >> "$LOG_FILE" 2>&1 || STATUS="FAILED"

echo "STATUS: $STATUS" >> "$LOG_FILE"