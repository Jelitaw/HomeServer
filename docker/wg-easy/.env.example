# Language of the web interface
LANG=en

# Public hostname used by WireGuard clients
WG_HOST=vpn.example.net

# Password hash for the WG-Easy web interface
PASSWORD_HASH=replace_with_password_hash

# VPN address range
WG_DEFAULT_ADDRESS=10.8.0.x

# DNS resolver available to VPN clients
WG_DEFAULT_DNS=YOUR_DNS_SERVER