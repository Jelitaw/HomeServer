services:
  pihole:
    image: pihole/pihole:latest
    container_name: pihole

    environment:
      TZ: "Europe/Berlin"
      WEBPASSWORD: ${WEBPASSWORD}

    volumes:
      - ./data/etc-pihole:/etc/pihole
      - ./data/etc-dnsmasq.d:/etc/dnsmasq.d

    ports:
      - "53:53/tcp"
      - "53:53/udp"
      - "8081:80/tcp"

    restart: unless-stopped

    networks:
      - homelab

networks:
  homelab:
    external: true