services:
  mealie:
    image: ghcr.io/mealie-recipes/mealie:v3.23.1
    container_name: mealie
    restart: unless-stopped

    deploy:
      resources:
        limits:
          memory: 1000M

    environment:
      ALLOW_SIGNUP: "false"
      PUID: 1000
      PGID: 1000
      TZ: ${TZ}
      BASE_URL: https://mealie.example.net

    volumes:
      - ./data:/app/data

    networks:
      - homelab

networks:
  homelab:
    external: true